  "opt_google_label": {
    "message": "API 密钥"
  },
  "opt_google_step1": {
    "message": "打开 Google Cloud Console，创建（或选择）一个项目。"
  },
  "opt_google_step2": {
    "message": "启用“PageSpeed Insights API”和“Chrome UX Report API”（链接见下方）。"
  },
  "opt_google_step3": {
    "message": "进入“凭据” → “创建凭据” → “API 密钥”。"
  },
  "opt_google_step4": {
    "message": "将密钥粘贴到此处并点击“保存”。这两个 API 均免费。"
  },
  "opt_cf_title": {
    "message": "Cloudflare API 令牌（Radar 排名）"
  },
  "opt_cf_desc": {
    "message": "增加 Cloudflare Radar 流行度排名、网站分类和主要国家。保存时会请求仅访问 api.cloudflare.com 的权限。"
  },
  "opt_cf_label": {
    "message": "API 令牌"
